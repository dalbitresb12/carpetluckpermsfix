{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/dalbitresb12/carpetluckpermsfix",
    "issues": "https://github.com/dalbitresb12/carpetluckpermsfix/issues"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "luckperms": ">=${luckperms_version}",
    "carpet": ">=${carpet_version}"
  },
  "custom": {
    "mc-publish": {
      "dependencies": [
        "luckperms(recommended){modrinth:Vebnzrzj}",
        "carpet@(recommended){modrinth:TQTTVgYE}"
      ]
    }
  }
}
